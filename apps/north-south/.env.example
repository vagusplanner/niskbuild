# North South — Vite env (copy to .env.local; never commit real keys)
# Use the same production Supabase project as VP / NiskBuild.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# NiskBuild API origin for /api/north-south/* (LLM, upload, transcribe, email).
# Leave empty for local dev — Vite proxies /api → http://localhost:3000.
# Production example: https://www.niskbuild.com
VITE_API_BASE_URL=
