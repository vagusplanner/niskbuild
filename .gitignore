# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
.pdf-tools
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/tmp/project-exports
/tmp/app-imports
/apps/imported/*
!/apps/imported/.gitkeep

# esbuild-wasm binary (copied from node_modules for Full App preview)
/public/preview-runtime/esbuild.wasm
.tmp-full-app-preview-spike/
.tmp-full-app-smoke/
.tmp-sentry-sweep/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
.env.local
.env.production
.env.development
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/shift-ai-reference/
.env*
